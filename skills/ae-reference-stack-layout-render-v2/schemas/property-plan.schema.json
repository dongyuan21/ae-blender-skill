{
  "title": "Frozen expected-old/new AE property transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "createdAt",
    "safety",
    "propertyUpdateCount",
    "propertyUpdates",
    "dependencyLocks",
    "requiredDisabledLayers",
    "qaBaseline",
    "routeScope",
    "editPolicy",
    "provenance",
    "inputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "artifactType": {
      "const": "property-plan"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalAepEdited",
        "referenceSourceAepUsed",
        "referenceSourceGeometryUsed"
      ],
      "properties": {
        "originalAepEdited": {
          "const": false
        },
        "referenceSourceAepUsed": {
          "const": false
        },
        "referenceSourceGeometryUsed": {
          "const": false
        }
      }
    },
    "propertyUpdateCount": {
      "type": "integer",
      "minimum": 0
    },
    "propertyUpdates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "compId",
          "layerIndex",
          "layerName",
          "sourceId",
          "propertyMatchName",
          "expectedNumKeys"
        ],
        "properties": {
          "compId": {
            "type": "integer"
          },
          "layerIndex": {
            "type": "integer",
            "minimum": 1
          },
          "layerName": {
            "type": "string"
          },
          "sourceId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "propertyMatchName": {
            "enum": [
              "ADBE Position",
              "ADBE Scale"
            ]
          },
          "expectedNumKeys": {
            "type": "integer",
            "minimum": 0
          },
          "expectedValue": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "number"
            }
          },
          "newValue": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "number"
            }
          },
          "tolerance": {
            "type": "number",
            "minimum": 0
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "keyNumber",
                "expectedOld",
                "newValue",
                "tolerance"
              ],
              "properties": {
                "keyNumber": {
                  "type": "integer",
                  "minimum": 1
                },
                "expectedOld": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "newValue": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "expectedValue",
              "newValue",
              "tolerance"
            ]
          },
          {
            "required": [
              "keys"
            ]
          }
        ]
      }
    },
    "dependencyLocks": {
      "type": "array"
    },
    "requiredDisabledLayers": {
      "type": "array"
    },
    "qaBaseline": {
      "type": "object",
      "required": [
        "acceptedMissingKeys",
        "acceptedExpressionErrorKeys",
        "acceptedEnabledWatermarkKeys"
      ],
      "properties": {
        "acceptedMissingKeys": {
          "type": "array"
        },
        "acceptedExpressionErrorKeys": {
          "type": "array"
        },
        "acceptedEnabledWatermarkKeys": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "routeScope": {
      "type": "object",
      "required": [
        "compIds",
        "routeCriticalFootageItemIds"
      ],
      "properties": {
        "compIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "routeCriticalFootageItemIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    },
    "editPolicy": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "sourceFactsSha256",
        "capacityPlanSha256",
        "assignmentSha256",
        "simulationSha256",
        "inspectionSha256"
      ],
      "properties": {
        "sourceFactsSha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "capacityPlanSha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "assignmentSha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "simulationSha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "inspectionSha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "sourceRouteSha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "sourceRoute": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "options": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "editPolicyInput": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/ae-stack-v2/property-plan.schema.json"
}
